{
  "schema_version": 1,
  "id": "result-v1",
  "description": "Check a small machine-readable result shape.",
  "mode": "json",
  "forbidden_patterns": [],
  "fields": [
    {"path": "/id", "type": "string", "required": true, "min_length": 1},
    {"path": "/status", "type": "string", "required": true, "enum": ["accepted", "rejected"]},
    {"path": "/count", "type": "integer", "required": true, "minimum": 0, "maximum": 100},
    {"path": "/items", "type": "array", "required": true, "min_length": 1}
  ],
  "allowed_root_keys": ["id", "status", "count", "items"]
}
